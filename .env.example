# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # SECRET_KEY
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENV=development
DEBUG=true
APP_NAME=roadtojapan
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string-at-least-16-chars

# --- Host port mapping -----------------------------------------------------
APP_PORT=8000

# --- PostgreSQL ------------------------------------------------------------
# POSTGRES_HOST is set to `postgres` by Compose; override only when running
# the app outside Docker against the published port (then use `localhost`).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=roadtojapan
POSTGRES_USER=roadtojapan
POSTGRES_PASSWORD=change-me-postgres-password

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_LIMITER=1
REDIS_DB_SESSION=2

CACHE_DEFAULT_TIMEOUT=300
RATELIMIT_DEFAULT=200 per minute

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_JSON=false

# --- Container entrypoint behaviour ----------------------------------------
WAIT_FOR_SERVICES=1
WAIT_TIMEOUT=60
RUN_MIGRATIONS=1
RUN_SEED=1

# --- Gunicorn (production target only) -------------------------------------
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
